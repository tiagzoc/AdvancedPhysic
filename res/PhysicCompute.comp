bool CheckCollision_OBB_OBB(Collider obb1, Collider obb2)
{
    // --- Axes locaux normalisés (world space)
    vec3 axesA[3] = vec3[3](
        normalize(obb1.rotation[0].xyz),
        normalize(obb1.rotation[1].xyz),
        normalize(obb1.rotation[2].xyz)
    );

    vec3 axesB[3] = vec3[3](
        normalize(obb2.rotation[0].xyz),
        normalize(obb2.rotation[1].xyz),
        normalize(obb2.rotation[2].xyz)
    );

    vec3 halfA = obb1.half_extent.xyz;
    vec3 halfB = obb2.half_extent.xyz;

    // Centre → centre (world space)
    vec3 delta = obb2.position.xyz - obb1.position.xyz;

    float minPenetration = 1e20;
    vec3 bestAxis = vec3(0.0);

    // ==============================
    // 1) Axes de A
    // ==============================
    for (int i = 0; i < 3; ++i)
    {
        vec3 axis = axesA[i];

        float dist = abs(dot(delta, axis));

        float rA = halfA[i];

        float rB =
            halfB.x * abs(dot(axesB[0], axis)) +
            halfB.y * abs(dot(axesB[1], axis)) +
            halfB.z * abs(dot(axesB[2], axis));

        float penetration = (rA + rB) - dist;
        if (penetration < 0.0)
            return false;

        if (penetration < minPenetration)
        {
            minPenetration = penetration;
            bestAxis = axis;
        }
    }

    // ==============================
    // 2) Axes de B
    // ==============================
    for (int i = 0; i < 3; ++i)
    {
        vec3 axis = axesB[i];

        float dist = abs(dot(delta, axis));

        float rA =
            halfA.x * abs(dot(axesA[0], axis)) +
            halfA.y * abs(dot(axesA[1], axis)) +
            halfA.z * abs(dot(axesA[2], axis));

        float rB = halfB[i];

        float penetration = (rA + rB) - dist;
        if (penetration < 0.0)
            return false;

        if (penetration < minPenetration)
        {
            minPenetration = penetration;
            bestAxis = axis;
        }
    }

    // ==============================
    // 3) Axes croisés (edge-edge)
    // ==============================
    for (int i = 0; i < 3; ++i)
    {
        for (int j = 0; j < 3; ++j)
        {
            vec3 axis = cross(axesA[i], axesB[j]);

            float len2 = dot(axis, axis);
            if (len2 < 1e-6)
                continue; // axes quasi parallèles

            axis = normalize(axis);

            float dist = abs(dot(delta, axis));

            float rA =
                halfA.x * abs(dot(axesA[0], axis)) +
                halfA.y * abs(dot(axesA[1], axis)) +
                halfA.z * abs(dot(axesA[2], axis));

            float rB =
                halfB.x * abs(dot(axesB[0], axis)) +
                halfB.y * abs(dot(axesB[1], axis)) +
                halfB.z * abs(dot(axesB[2], axis));

            float penetration = (rA + rB) - dist;
            if (penetration < 0.0)
                return false;

            if (penetration < minPenetration)
            {
                minPenetration = penetration;
                bestAxis = axis;
            }
        }
    }

    // ==============================
    // Collision confirmée
    // ==============================

    uint i_impact = atomicCounterIncrement(impactCount);
    if (i_impact >= maxImpacts)
        return false;

    // Orientation cohérente de la normale (A → B)
    if (dot(bestAxis, delta) < 0.0)
        bestAxis = -bestAxis;

    impacts[i_impact].normal = vec4(normalize(bestAxis), 0.0);
    impacts[i_impact].penetration = minPenetration;
    impacts[i_impact].local_collision_point_1 = vec4(0.0);
    impacts[i_impact].local_collision_point_2 = vec4(0.0);
    impacts[i_impact].entity_index1 = obb1.entity_index;
    impacts[i_impact].entity_index2 = obb2.entity_index;

    return true;
}


// ===============
// type 0: sphere
// type 1: AABB
// type 2: OBB
// ===============

void main()
{
    uint id = gl_GlobalInvocationID.x;
    if(id >= numColliders) return;

    for (uint j = id + 1; j < numColliders; ++j)
    {
        if(colliders[j].entity_index == colliders[id].entity_index) continue; 
        if (abs(colliders[id].cell_coordinates.x - colliders[j].cell_coordinates.x) > 1) continue;
        if (abs(colliders[id].cell_coordinates.y - colliders[j].cell_coordinates.y) > 1) continue;
        if (abs(colliders[id].cell_coordinates.z - colliders[j].cell_coordinates.z) > 1) continue;

        if(colliders[id].type == 0)
        {
            if(colliders[j].type == 0)
            {
                CheckCollision_Sphere_Sphere(colliders[id], colliders[j]);
            }
            else if(colliders[j].type == 1)
            {
                CheckCollision_AABB_Sphere(colliders[j], colliders[id]);
            }
            else if(colliders[j].type == 2)
            {
                CheckCollision_Sphere_OBB(colliders[id], colliders[j]);
            }
        }
        else if(colliders[id].type == 1)
        {
            if(colliders[j].type == 0)
            {
                CheckCollision_AABB_Sphere(colliders[id], colliders[j]);
            }
            else if(colliders[j].type == 1)
            {
                CheckCollision_AABB_AABB(colliders[id], colliders[j]);
            }
            else if(colliders[j].type == 2)
            {
                CheckCollision_AABB_OBB(colliders[id], colliders[j]);
            }
        }
        else if(colliders[id].type == 2)
        {
            if(colliders[j].type == 0)
            {
                CheckCollision_Sphere_OBB(colliders[j], colliders[id]);
            }
            else if(colliders[j].type == 1)
            {
                CheckCollision_AABB_OBB(colliders[j], colliders[id]);
            }
            else if(colliders[j].type == 2)
            {
                CheckCollision_OBB_OBB(colliders[id], colliders[j]);
            }
        }
    }
}