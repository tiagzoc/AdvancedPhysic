#version 430 core
layout (local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

struct Collider
{
    mat4 rotation;
    vec4 position; 
    vec4 half_extent;
    ivec4 cell_coordinates;
    uint entity_index;   
    uint type;
    int pad[2];
};

struct Impact
{
    vec4 local_collision_point_1;
    vec4 local_collision_point_2;
    vec4 normal;
    float penetration;
    uint entity_index1;
    uint entity_index2;
    int pad;
};

layout(std430, binding = 0) readonly buffer CollidersBuffer
{
    Collider colliders[];
};

layout(std430, binding = 1) writeonly buffer ImpactsBuffer
{
    Impact impacts[];
};  

layout(binding = 2) uniform atomic_uint impactCount;

uniform uint numColliders;
uniform uint maxImpacts;

float Radius(Collider c)
{
    return max(c.half_extent.x, max(c.half_extent.y, c.half_extent.z));
}

bool CheckCollision_Sphere_Sphere(Collider sphere1, Collider sphere2)
{    
    vec3 delta = sphere2.position.xyz - sphere1.position.xyz;
    float sq_distance = dot(delta, delta);

    float r1 = Radius(sphere1);
    float r2 = Radius(sphere2);
    float sum_radii = r1 + r2;
    if(sq_distance > sum_radii * sum_radii) return false; // No collision

    float d = sqrt(sq_distance);

    uint i_impact = atomicCounterIncrement(impactCount);
    if(i_impact >= maxImpacts) return false; // No more space to store impacts
    
    vec4 n = vec4(0.0, 1.0, 0.0, 0.0); 
    if(d > 0.0) n = vec4(delta.x / d, delta.y / d, delta.z / d, 0.0);

    impacts[i_impact].normal = n;
    impacts[i_impact].penetration = sum_radii - d;
    impacts[i_impact].local_collision_point_1 = n * r1;
    impacts[i_impact].local_collision_point_2 = -n * r2;
    impacts[i_impact].entity_index1 = sphere1.entity_index;
    impacts[i_impact].entity_index2 = sphere2.entity_index;

    return true; // Placeholder return value
}

bool CheckCollision_AABB_Sphere(Collider aabb, Collider sphere)
{
    float r = Radius(sphere);

    vec3 delta = sphere.position.xyz - aabb.position.xyz;
    vec3 closest_point = clamp(delta, -aabb.half_extent.xyz, aabb.half_extent.xyz);
    vec3 difference = delta - closest_point;
    
    float sq_distance = dot(difference, difference);
    if(sq_distance > r * r) return false; // No collision

    uint i_impact = atomicCounterIncrement(impactCount);
    if(i_impact >= maxImpacts) return false; // No more space to store impacts

    float d = sqrt(sq_distance);
    vec3 collision_normal = vec3( 0, 1, 0 );
    if (d == 0)
        collision_normal = normalize(delta);
    else
        collision_normal = difference / d;

    impacts[i_impact].local_collision_point_1 = vec4(0.0); 
    impacts[i_impact].local_collision_point_2 = vec4(-collision_normal * r, 0.0);
    impacts[i_impact].normal = vec4(collision_normal, 0.0);
    impacts[i_impact].penetration = r - d;
    impacts[i_impact].entity_index1 = aabb.entity_index;
    impacts[i_impact].entity_index2 = sphere.entity_index;

    return true;
}

vec3 FACES[6] = vec3[6](
    vec3(-1,  0,  0), vec3(1, 0, 0),
    vec3( 0, -1,  0), vec3(0, 1, 0),
    vec3( 0,  0, -1), vec3(0, 0, 1)
);

bool CheckCollision_AABB_AABB(Collider aabb1, Collider aabb2)
{
    vec3 delta = aabb2.position.xyz - aabb1.position.xyz;
    vec3 sum_half_extents = aabb1.half_extent.xyz + aabb2.half_extent.xyz;
    if (
        abs(delta.x) > sum_half_extents.x ||
        abs(delta.y) > sum_half_extents.y ||
        abs(delta.z) > sum_half_extents.z
        ) return false; // NO COLLISION

    uint i_impact = atomicCounterIncrement(impactCount);
    if(i_impact >= maxImpacts) return false; // No more space to store impacts

    vec3 max1 = aabb1.position.xyz + aabb1.half_extent.xyz;
    vec3 min1 = aabb1.position.xyz - aabb1.half_extent.xyz;

    vec3 max2 = aabb2.position.xyz + aabb2.half_extent.xyz;
    vec3 min2 = aabb2.position.xyz - aabb2.half_extent.xyz;

    float distances[6] = float[6](
        max2.x - min1.x,
        max1.x - min2.x,
        max2.y - min1.y,
        max1.y - min2.y,
        max2.z - min1.z,
        max1.z - min2.z
    );

    float penetration = 1e10;
    vec3 bestAxis = vec3( 0, 1, 0 );

    for (int i = 0; i < 6; ++i)
    {
        if (distances[i] < penetration) {
            penetration = distances[i];
            bestAxis = FACES[i];
        }
    }

    impacts[i_impact].normal = vec4(bestAxis, 0.0);
    impacts[i_impact].penetration = penetration;
    impacts[i_impact].local_collision_point_1 = vec4(0.0);
    impacts[i_impact].local_collision_point_2 = vec4(0.0);
    impacts[i_impact].entity_index1 = aabb1.entity_index;
    impacts[i_impact].entity_index2 = aabb2.entity_index;

    return true;
}

